<?xml version="1.0" encoding="utf-8"?>
<!-- Launcher icon: the Prism mark (tools/brand.py draws the foreground from docs/brand/) on the app's night colour.
     The monochrome layer is the same mark; Android 13+ tints it for themed icons. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/surface" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
    <monochrome android:drawable="@drawable/ic_launcher_foreground" />
</adaptive-icon>
